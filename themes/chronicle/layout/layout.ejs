<!DOCTYPE html>
<% var langFromPage = page && page.lang; var langFromConfig =
Array.isArray(config.language) ? config.language[0] : config.language; var
htmlLang = langFromPage || langFromConfig || 'en'; %>
<html lang="<%= htmlLang %>">
  <%- partial('_partial/head') %>
  <body>
    <%- partial('_partial/header') %>

    <div class="printer-slot">
      <div class="printer-slot__inner">
        <div class="printer-blueprint">
          <!-- Left Mechanical Unit -->
          <div class="printer-gear-unit">
            <div class="printer-roller-wire"></div>
            <div class="printer-tech-label">UNIT-L</div>
          </div>

          <!-- Center Output Slot -->
          <div class="printer-output-unit">
            <div class="printer-path-line"></div>
            <div class="printer-slot__slit"></div>
            <div class="printer-tech-tag">MAIN OUTPUT SECTOR</div>
          </div>

          <!-- Right Mechanical Unit -->
          <div class="printer-gear-unit">
            <div class="printer-roller-wire"></div>
            <div class="printer-tech-label">UNIT-R</div>
          </div>
          
          <div class="printer-led" id="printer-led"></div>
        </div>
      </div>
    </div>

    <main class="main printer-paper">
      <div class="container"><%- body %></div>
      <div class="paper-tear"></div>
    </main>

    <%- partial('_partial/footer') %> <%- partial('_partial/scripts') %>
  </body>
</html>
